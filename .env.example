# ─────────────────────────────────────────────────────────────
#  DevGuard AI  —  Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env with real secrets to version control.
# ─────────────────────────────────────────────────────────────

# ── LLM Provider (Required) ───────────────────────────────────

# Google Gemini (Get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI (Alternative provider fallback)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── Backend Configuration ──────────────────────────────────────
BACKEND_HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000

# CORS Allowed Origins (comma-separated, or * for public access)
CORS_ORIGINS=*

# ── Repository Analyzer Limits ─────────────────────────────────
MAX_CONTEXT_BYTES=60000
MAX_FILE_BYTES=15000

# ── Frontend Configuration (Vite) ─────────────────────────────
# In production (when frontend is deployed separately), set to backend URL:
# VITE_API_URL=https://your-backend-service.onrender.com
